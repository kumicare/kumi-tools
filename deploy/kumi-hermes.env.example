# Copy to /home/che/.config/kumi/hermes.env with mode 0600.
# Never commit the populated file.
KUMI_SUPABASE_URL=https://uahzamhpbbzintsalqgg.supabase.co
KUMI_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
KUMI_SUPABASE_EMAIL=<dedicated-integration-user-email>
KUMI_SUPABASE_PASSWORD=<dedicated-integration-user-password>

# Keep false through the read-only spike. Enable only after remote SQL tests pass.
KUMI_MUTATIONS_ENABLED=false

# Google Workspace access uses one service account that is explicitly shared on
# the configured spreadsheet and calendar. Never commit the JSON key.
KUMI_GOOGLE_SERVICE_ACCOUNT_FILE=/home/che/.config/kumi/google-service-account.json
KUMI_GOOGLE_SPREADSHEET_ID=<spreadsheet-id>
KUMI_GOOGLE_CALENDAR_ID=<calendar-id>

# Comma-separated exact worksheet names. Start with non-financial tabs only.
KUMI_GOOGLE_ALLOWED_SHEETS=注意事項,療程,行政,長照｜樂活
KUMI_GOOGLE_TIMEZONE=Asia/Taipei

# Keep false until read-only probes succeed and the dedicated calendar is verified.
KUMI_GOOGLE_MUTATIONS_ENABLED=false
